{
  "name": "xtract-bot",
  "version": "0.1.0",
  "description": "Telegram bot for sharing X/Twitter posts inside Telegram.",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun run src/main.ts",
    "dev": "bun run --watch src/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/db/migrate.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "grammy": "^1.42.0",
    "htmlparser2": "^10.0.0",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^22.18.13",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.4",
    "prettier": "^3.6.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.6"
  },
  "engines": {
    "bun": ">=1.1.0"
  }
}
