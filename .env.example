BOT_TOKEN=123456:replace-me
DATABASE_URL=postgres://xtract:xtract@postgres:5432/xtract
ADMIN_IDS=123456789
ACCESS_WHITELIST_ENABLED=true
RUSSIAN_TRANSLATION_ENABLED=false
TWEET_PROVIDER=public_embed
TWEET_CACHE_TTL_SECONDS=86400
# Cache "deleted/not found" results for this long so providers aren't re-hit.
NEGATIVE_CACHE_TTL_SECONDS=600
TWEET_PROVIDER_TIMEOUT_SECONDS=10
TRANSLATION_TIMEOUT_SECONDS=8
LOG_LEVEL=INFO

# Thread unrolling: collect a self-reply chain into one post.
THREAD_UNROLL_ENABLED=true
THREAD_MAX_TWEETS=10

# Per-user rate limit on tweet fetches (token bucket). Admins are exempt.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60

# Polling (default) or webhook. For webhook set POLLING_ENABLED=false and a
# public HTTPS WEBHOOK_URL; the bot serves it on WEBHOOK_PORT (or $PORT).
POLLING_ENABLED=true
WEBHOOK_URL=
WEBHOOK_SECRET=
WEBHOOK_PORT=8080

# External HTTP provider
TWEET_PROVIDER_BASE_URL=
TWEET_PROVIDER_API_KEY=

# X API v2 provider
X_BEARER_TOKEN=
