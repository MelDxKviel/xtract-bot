BOT_TOKEN=123456:replace-me
DATABASE_URL=postgres://xtract:xtract@postgres:5432/xtract
ADMIN_IDS=123456789
ACCESS_WHITELIST_ENABLED=true
RUSSIAN_TRANSLATION_ENABLED=false
TWEET_PROVIDER=public_embed
TWEET_CACHE_TTL_SECONDS=86400
# Profiles change more often than posts, so cache them for a shorter window.
PROFILE_CACHE_TTL_SECONDS=21600
# Cache "deleted/not found" results for this long so providers aren't re-hit.
NEGATIVE_CACHE_TTL_SECONDS=600

# Periodically delete expired cache rows so the table doesn't grow unbounded.
# Admins can also purge manually with /clearcache. Interval has a 60s floor.
CACHE_CLEANUP_ENABLED=true
CACHE_CLEANUP_INTERVAL_SECONDS=3600
TWEET_PROVIDER_TIMEOUT_SECONDS=10
TRANSLATION_TIMEOUT_SECONDS=8
LOG_LEVEL=INFO

# Thread unrolling: collect a self-reply chain into one post.
THREAD_UNROLL_ENABLED=true
THREAD_MAX_TWEETS=10

# Per-user rate limit on tweet fetches (token bucket). Admins are exempt.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60

# Avatar custom emoji: show a profile's avatar as an inline custom emoji in the
# shared message. The bot turns the avatar into a 100x100 custom-emoji sticker.
# IMPORTANT: Telegram only delivers bot-sent custom emoji when the bot is
# eligible — the bot owner has Telegram Premium, or the bot has a Fragment
# username. Otherwise viewers just see the fallback glyph (the message is fine).
# Created sticker sets are attributed to AVATAR_EMOJI_OWNER_ID (a Telegram user
# who has messaged the bot; defaults to the first ADMIN_IDS entry).
AVATAR_EMOJI_ENABLED=false
AVATAR_EMOJI_OWNER_ID=
AVATAR_EMOJI_TITLE_PREFIX=Xtract avatars

# Polling (default) or webhook. For webhook set POLLING_ENABLED=false and a
# public HTTPS WEBHOOK_URL; the bot serves it on WEBHOOK_PORT (or $PORT).
POLLING_ENABLED=true
WEBHOOK_URL=
WEBHOOK_SECRET=
WEBHOOK_PORT=8080

# External HTTP provider
TWEET_PROVIDER_BASE_URL=
TWEET_PROVIDER_API_KEY=

# X API v2 provider
X_BEARER_TOKEN=
